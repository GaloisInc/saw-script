// Test: module aliases (aka submodule synonyms), i.e.
//   submodule A = submodule B
// A module alias introduces no new names: `A::x` and `B::x` denote the
// very same thing.

import "Synonyms.cry";

/* *******************************
   the names of the aliased submodule are in scope under the alias:
 */

print {{ S::s }};
print {{ Syn::s }};

// ... at any depth, and through nested aliases:
print {{ S::S_Inner::s_inner }};
print {{ Syn::S_Inner::s_inner }};
print {{ Syn::S_InnerSyn::s_inner }};

// ... and through a chain of aliases:
print {{ SynSyn::s }};
print {{ SynSyn::S_InnerSyn::s_inner }};

// an alias for a top-level module works too:
print {{ CrySyn::min 4 5 }};


/* *******************************
   `import submodule` follows aliases:
 */

import submodule SynSyn;

print {{ s }};
print {{ S_Inner::s_inner }};
print {{ S_InnerSyn::s_inner }};


/* *******************************
   Aliases respect the 'public and private' import mechanism:
   redoing above tests but replacing `s_inner` with `s_inner_pri`
 */

// private in submodule:
print {{ S::s_pri }};

// private in submodule, via aliases:
print {{ Syn::s_pri }};
print {{ SynSyn::s_pri }};


// ... at any depth, and through nested aliases:
print {{ S::S_Inner::s_inner_pri }};
print {{ Syn::S_Inner::s_inner_pri }};

// ... using aliases inside submodules:

/*
// FIXME: these should succeed but they fail:
print {{ Syn::S_InnerSyn::s_inner_pri }};
print {{ SynSyn::S_InnerSyn::s_inner_pri }};
*/
