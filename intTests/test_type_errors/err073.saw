// Trigger what happens when you call a function that returns a
// (fixed-type) function with too many arguments.
//
// Also see err016, err065, err066, err074. If anyone ever renumbers
// the test dir, it might make sense to group these all together.

let f (x: String) : String -> String = str_concat x;
let y = f "abc" "def" "ghi";

