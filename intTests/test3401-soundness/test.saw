m <- mir_load_module "test.linked-mir.json";

let f_spec = do {
    x_arr <- mir_fresh_var "x_arr" (mir_array 4 mir_u8);
    x_ref <- mir_ref_of (mir_term x_arr);
    mir_execute_func [mir_slice_value x_ref];
    mir_return (mir_term {{ x_arr @ 0 }});
};

let g_spec_incorrect = do {
    x <- mir_fresh_var "x" (mir_array 2 (mir_array 4 mir_u8));
    x_ref <- mir_ref_of (mir_term x);
    mir_execute_func [x_ref];
    mir_return (mir_term {{ (x @ 0) @ 0 }});
};

let g_spec_correct = do {
    x <- mir_fresh_var "x" (mir_array 2 (mir_array 4 mir_u8));
    x_ref <- mir_ref_of (mir_term x);
    mir_execute_func [x_ref];
    mir_return (mir_term {{ (x @ 1) @ 0 }});
};

f_ov <- mir_verify m "test::f" [] false f_spec z3;

fails (mir_verify m "test::g" [] false g_spec_incorrect z3);
fails (mir_verify m "test::g" [f_ov] false g_spec_incorrect z3);

mir_verify m "test::g" [] false g_spec_correct z3;
mir_verify m "test::g" [f_ov] false g_spec_correct z3;
