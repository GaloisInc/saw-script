enable_experimental;

// W2(d) coverage: Prelude.mkFloat maps to the hand-library
// `mkFloat`. CONFORMANCE.md's "Float" row records why this is
// emission+behavior coverage, not differential conformance — SAW
// exposes no executable Float observer.
//
// Narrowed 2026-07-25 (audit-2 F-2): `Float` was bound to
// `Int x Int` and this row's observer pinned the pair components.
// That binding collapsed `Float` and `Double` into one type image,
// making SAW-invalid equations `rfl`-provable. `Float` is now a
// sealed abstract type with an uninterpreted constructor, so the
// components are unobservable from Lean — as they are from SAW.
let probe = parse_core "mkFloat (natToInt 1) (natToInt 2)";

write_lean_term "Observed" [] [] "emitted.lean" probe;
