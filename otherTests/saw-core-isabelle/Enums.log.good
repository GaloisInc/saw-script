cryptol_definition myEnum_discr :: "Bit" where
"myEnum_discr  \<equiv> complement`{Bit} ((MyNone`{Integer,1}) ==`{(Integer,1) MyEnum} (MySome`{Integer,1} (0 :: Integer)))"

cryptol_definition myEnum_eq :: "{'a,'b} ((Eq 'a,fin 'b) =?> ((('a,'b) MyEnum) \<Rightarrow> ((('a,'b) MyEnum) \<Rightarrow> Bit)))" where
"myEnum_eq x y \<equiv> case x of
    MyCtr2 _ _ i b a c \<Rightarrow> (case y of
      MyCtr2 _ _ i1 b1 a1 c1 \<Rightarrow> ((i ==`{Integer} i1) \<and> ((b ==`{['b]} b1) \<and> ((a ==`{'a} a1) \<and> (c ==`{Bit} c1))))
    | _ \<Rightarrow> (False))
  | MyNone _ _ \<Rightarrow> (case y of
      MyNone _ _ \<Rightarrow> (True)
    | _ \<Rightarrow> (False))
  | MySome _ _ a \<Rightarrow> (case y of
      MySome _ _ a1 \<Rightarrow> (a ==`{'a} a1)
    | _ \<Rightarrow> (False))"

cryptol_definition myEnum_eq_valid :: "{'a,'b,'c} ((Eq 'a,fin 'b,'b = 'c) =?> ((('a,'b) MyEnum) \<Rightarrow> ((('a,'c) MyEnum) \<Rightarrow> Bit)))" where
"myEnum_eq_valid x y \<equiv> (myEnum_eq`{'a,'b} x y) ==`{Bit} (x ==`{('a,'b) MyEnum} y)"

cryptol_definition opt_discr :: "Bit" where
"opt_discr  \<equiv> complement`{Bit} ((None`{Integer}) ==`{(Integer) Option} (Some`{Integer} (0 :: Integer)))"

cryptol_definition opt_valid :: "{'a,'b} ((fin 'a,'a = 'b) =?> (((['a]) Option) \<Rightarrow> (((['b]) Option) \<Rightarrow> Bit)))" where
"opt_valid x y \<equiv> case x of
    None _ \<Rightarrow> (case y of
      None _ \<Rightarrow> (x ==`{(['a]) Option} y)
    | Some _ b \<Rightarrow> (complement`{Bit} (x ==`{(['a]) Option} y)))
  | Some _ a \<Rightarrow> (case y of
      None _ \<Rightarrow> (complement`{Bit} (x ==`{(['a]) Option} y))
    | Some _ b \<Rightarrow> ((a ==`{['b]} b) ==`{Bit} (x ==`{(['a]) Option} y)))"

