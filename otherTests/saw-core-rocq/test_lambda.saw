// Test: Lambda abstraction, application.
let f = {{ \(x : [8]) -> x + 1 }};
let t1 = {{ f 5 }};
write_rocq_term "TestLambda_App" [] [] "test_lambda_1.v" t1;

let g = {{ \(x : [8]) -> \(y : [8]) -> x + y }};
let t2 = {{ g 3 4 }};
write_rocq_term "TestLambda_TwoArgs" [] [] "test_lambda_2.v" t2;

let t3 = {{ g 10 }};
write_rocq_term "TestLambda_Partial" [] [] "test_lambda_3.v" t3;

let h = {{ \(x : [8]) -> x * 2 }};
let t4 = {{ f (h 5) }};
write_rocq_term "TestLambda_Nested" [] [] "test_lambda_4.v" t4;

let id = {{ \(x : [8]) -> x }};
let t5 = {{ id 42 }};
write_rocq_term "TestLambda_Id" [] [] "test_lambda_5.v" t5;
