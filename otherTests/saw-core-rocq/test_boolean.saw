// Test: Boolean, comparison operators.
let t1 = {{ True && False || ~True == True}};
write_rocq_term "TestBool" [] [] "test_boolean_1.v" t1;

let t2 = {{ (((t1 && t1) || ~(~t1)) ^ t1) != True}};
write_rocq_term "TestBool_NestedOps" [] [] "test_boolean_2.v" t2;

let t3 = {{ ((10 : [8]) < 5) && (10 > 5) && (5 <= 10) && (10 >= 5) }};
write_rocq_term "TestBool_Comparison" [] [] "test_boolean_3.v" t3;

let t4 = {{ if (5 : [8]) < 10 then 1 else 2 }};
write_rocq_term "TestBool_Ite1" [] [] "test_boolean_4.v" t4;

let t5 = {{ if True then (if False then (1 : [8]) else 2) else 3 }};
write_rocq_term "TestBool_Ite2" [] [] "test_boolean_5.v" t5;

let t6 = parse_core "ite Bool";
write_rocq_term "TestPartialIte_1arg" [] [] "test_boolean_6.v" t6;

let t7 = parse_core "ite Bool True";
write_rocq_term "TestPartialIte_2args" [] [] "test_boolean_7.v" t7;

let t8 = parse_core "ite Bool True False";
write_rocq_term "TestPartialIte_3args" [] [] "test_boolean_8.v" t8;

let t9 = parse_core "ite Bool True False True";
write_rocq_term "TestPartialIte_4args" [] [] "test_boolean_9.v" t9;

let t10 = parse_core "ite (Bool -> Bool) True not (id Bool) False";
write_rocq_term "TestPartialIte_5args" [] [] "test_boolean_10.v" t10;
