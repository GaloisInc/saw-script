// Test: Literals.
let t1 = {{ "" }};
write_rocq_term "TestString_Empty" [] [] "test_literals_1.v" t1;

let t2 = {{ "The quick brown fox jumps over the lazy dog" }};
write_rocq_term "TestString_Basic" [] [] "test_literals_2.v" t2;

let t3 = {{ "\"Line 1\"\nLine 2\tTabbed\r\nLine 3\rpath\\to\\file" }};
write_rocq_term "TestString_Escapes" [] [] "test_literals_3.v" t3;

let t4 = {{ "Hello, world! (--what?) No; it's a test. At least: [b] {c}" }};
write_rocq_term "TestString_Punct" [] [] "test_literals_4.v" t4;

let t5 = {{ "1 + 2^6 <= n_2, 5 - 3@2# => 2 * 999 / 4% & y | ~x" }};
write_rocq_term "TestString_Mathy" [] [] "test_literals_5.v" t5;

let t6 = {{ "café" }};
write_rocq_term "TestString_Accent" [] [] "test_literals_6.v" t6;

let t7 = {{ 0xFFFFFFFFFFFFFFFF : [64] }};
write_rocq_term "TestLit_Max64" [] [] "test_literals_7.v" t7;

// Decimal literal
let t8 = {{ 0254 }};
write_rocq_term "TestLit_0254" [] [] "test_literals_8.v" t8;

// Binary literal
let t9 = {{ 0b11111110 }};
write_rocq_term "TestLit_Bin" [] [] "test_literals_9.v" t9;

// Octal literal
let t10 = {{ 0o376 }};
write_rocq_term "TestLit_Oct" [] [] "test_literals_10.v" t10;

// Hexadecimal literal
let t11 = {{ 0xFE }};
write_rocq_term "TestLit_Hex1" [] [] "test_literals_11.v" t11;

// Hexadecimal literal
let t12 = {{ 0xfe }};
write_rocq_term "TestLit_Hex2" [] [] "test_literals_12.v" t12;

// : [7], equal to 0b1010111
let t13 = {{ <| x^^6 + x^^4 + x^^2 + x^^1 + 1 |> }};
write_rocq_term "TestLit_Poly1" [] [] "test_literals_13.v" t13;

// : [5], equal to 0b11010
let t14 = {{ <| x^^4 + x^^3 + x |> }};
write_rocq_term "TestLit_Poly2" [] [] "test_literals_14.v" t14;
