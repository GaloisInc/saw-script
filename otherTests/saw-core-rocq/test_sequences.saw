// Test: Sequence operations.
let t1 = {{ [1, 2, 3, 255] : [4][8] }};
write_rocq_term "TestSeq" [] [] "test_sequences_1.v" t1;

let t2 = {{ [255] : [1][8] }};
write_rocq_term "TestSeq_Single" [] [] "test_sequences_2.v" t2;

let t3 = {{ [] : [0][8] }};
write_rocq_term "TestSeq_Empty" [] [] "test_sequences_3.v" t3;

let t4 = {{ [1, 2, 3, 4, 5, 6, 7, 8] : [8][16] }};
write_rocq_term "TestSeq_Eight" [] [] "test_sequences_4.v" t4;

let t5 = {{ take`{3} ([1, 2, 3, 4, 5] : [5][8]) }};
write_rocq_term "TestSeq_Take3" [] [] "test_sequences_5.v" t5;

let t6 = {{ take`{5} ([1, 2, 3, 4, 5] : [5][8]) }};
write_rocq_term "TestSeq_TakeAll" [] [] "test_sequences_6.v" t6;

let t7 = {{ take`{0} ([1, 2, 3] : [3][8]) }};
write_rocq_term "TestSeq_TakeZero" [] [] "test_sequences_7.v" t7;

let t8 = {{ drop`{2} ([1, 2, 3, 4, 5] : [5][8]) }};
write_rocq_term "TestSeq_Drop" [] [] "test_sequences_8.v" t8;

let t9 = {{ drop`{3} ([1, 2, 3] : [3][8]) }};
write_rocq_term "TestSeq_DropAll" [] [] "test_sequences_9.v" t9;

let t10 = {{ drop`{0} ([1, 2, 3] : [3][8]) }};
write_rocq_term "TestSeq_DropZero" [] [] "test_sequences_10.v" t10;

let t11 = {{ take`{2} (drop`{1} ([1, 2, 3, 4] : [4][8])) }};
write_rocq_term "TestSeq_TakeDrop" [] [] "test_sequences_11.v" t11;

let t12 = {{ update ([1, 2, 3, 4] : [4][8]) 2 99 }};
write_rocq_term "TestSeq_Update" [] [] "test_sequences_12.v" t12;

let t13 = {{ update ([1, 2, 3, 4] : [4][8]) 0 99 }};
write_rocq_term "TestSeq_UpdateFirst" [] [] "test_sequences_13.v" t13;

let t14 = {{ update ([1, 2, 3, 4] : [4][8]) 3 99 }};
write_rocq_term "TestSeq_UpdateLast" [] [] "test_sequences_14.v" t14;

let t15 = {{ update (update ([1, 2, 3, 4] : [4][8]) 0 10) 1 20 }};
write_rocq_term "TestSeq_UpdateMult" [] [] "test_sequences_15.v" t15;

let t16 = {{ zip ([1, 2, 3] : [3][8]) ([4, 5, 6] : [3][8]) }};
write_rocq_term "TestSeq_Zip" [] [] "test_sequences_16.v" t16;

let t17 = {{ map (\(x : [8]) -> x + 1) ([1, 2, 3] : [3][8]) }};
write_rocq_term "TestSeq_Map" [] [] "test_sequences_17.v" t17;

let t18 = {{ foldl (+) (0 : [16]) ([1, 2, 3, 4] : [4][16]) }};
write_rocq_term "TestSeq_Fold" [] [] "test_sequences_18.v" t18;

let t19 = {{ [1, 2] # [3, 4] : [4][8] }};
write_rocq_term "TestSeq_Concat" [] [] "test_sequences_19.v" t19;

let t20 = {{ [ x + 1 | x <- [1, 2, 3, 4] ] : [4][8] }};
write_rocq_term "TestSeq_Comprehension" [] [] "test_sequences_20.v" t20;

let t21 = {{ reverse ([1, 2, 3, 4] : [4][8]) }};
write_rocq_term "TestSeq_Reverse" [] [] "test_sequences_21.v" t21;

let t22 = {{ transpose [[1, 2], [3, 4]] : [2][2][8] }};
write_rocq_term "TestSeq_Transpose" [] [] "test_sequences_22.v" t22;

let t23 = {{ [1, 2, 3, 4] @ 2 : [8] }};
write_rocq_term "TestSeq_Index" [] [] "test_sequences_23.v" t23;
