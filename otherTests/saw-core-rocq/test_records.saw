// Test: Record types, values, operations.
let t1 = {{ {x = 1, y = 2} : {x : [8], y : [8]} }};
write_rocq_term "TestRec" [] [] "test_records_1.v" t1;

let t2 = {{ {val = 42} : {val : [8]} }};
write_rocq_term "TestRec_Single" [] [] "test_records_2.v" t2;

let t3 = {{ {a = 1, b = 2, c = 3} : {a : [8], b : [8], c : [8]} }};
write_rocq_term "TestRec_Three" [] [] "test_records_3.v" t3;

let t4 = {{ {x = 1, y = 2} : {x : [8], y : [16]} }};
write_rocq_term "TestRec_MixedWidth" [] [] "test_records_4.v" t4;

let t5 = {{ {inner = {x = 1, y = 2}, z = 3} : {inner : {x : [8], y : [8]}, z : [8]} }};
write_rocq_term "TestRec_Nested" [] [] "test_records_5.v" t5;

let t6 = {{ {x = 42, y = 100}.y : [8] }};
write_rocq_term "TestRec_ProjY" [] [] "test_records_6.v" t6;

let t7 = {{ {inner = {x = 1, y = 2}, z = 3}.inner.x : [8] }};
write_rocq_term "TestRec_NestedProj" [] [] "test_records_7.v" t7;

let t8 = {{ { t1 | x = 3 } : {x : [8], y : [8]} }};
write_rocq_term "TestRec_Update1" [] [] "test_records_8.v" t8;

let t9 = {{ (True, True) }};
write_rocq_term "TestRec_Tuple" [] [] "test_records_9.v" t9;

let t10 = {{ { pt = t1, size = 100 } }};
write_rocq_term "TestRec_Nested" [] [] "test_records_10.v" t10;

let t11 = {{ { t1 | x = 30 }          == { x = 30, y = 20 } }};
write_rocq_term "TestRec_Update2" [] [] "test_records_11.v" t11;

let t12 = {{ { t9 | 0 = False }       == (False,True) }};
write_rocq_term "TestRec_TupleUpdate" [] [] "test_records_12.v" t12;

let t13 = {{ { t1 | x -> x + 5 }      == { x = 20, y = 20 } }};
write_rocq_term "TestRec_RelativeUpdate" [] [] "test_records_13.v" t13;

let t14 = {{ { t10 | pt.x = 10 }       == { pt = { x = 10, y = 20 }, size = 100 } }};
write_rocq_term "TestRec_NestedField1" [] [] "test_records_14.v" t14;

let t15 = {{ { t10 | pt.x -> x + 10 }  == { pt = { x = 25, y = 20 }, size = 100 } }};
write_rocq_term "TestRec_NestedField2" [] [] "test_records_15.v" t15;
